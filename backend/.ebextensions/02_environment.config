# Non-secret environment defaults only.
#
# Do NOT add secrets (SESSION_SECRET, MONGODB_URI, GOOGLE_CLIENT_SECRET,
# SMTP_PASS, VAPID_PRIVATE_KEY, etc.) here — this file is committed to
# source control and would leak them. Set secrets via one of:
#   eb setenv KEY=value KEY2=value2
#   EB Console → Configuration → Software → Environment properties
#   (preferred for real prod) AWS Secrets Manager / SSM Parameter Store,
#     referenced from a startup hook instead of plain env vars
#
# ENABLE_CRON is deliberately NOT set here either — it must differ per
# environment (exactly one running environment/instance should have it
# set to 'true'; see backend/server.js). Set it per-environment with
# `eb setenv ENABLE_CRON=true` on the one designated environment.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
