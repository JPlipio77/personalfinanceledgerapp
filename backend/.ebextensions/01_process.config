# Elastic Beanstalk process/health-check configuration.
#
# Two problems this fixes, both otherwise fatal on first deploy:
#
# 1. Port mismatch — the EB Node.js platform's nginx reverse proxy forwards
#    traffic to 127.0.0.1:8080 by default. This app listens on PORT
#    (default 5000, see backend/server.js and Dockerfile). Without the
#    Port override below, every request 502s at the proxy.
#
# 2. Health check path — the app has no "/" route (only "/health" and
#    "/api/*"), so the load balancer's default health check ("/") gets a
#    404 and marks the environment Degraded/Severe, which can trigger
#    instance recycling. HealthCheckPath fixes this.
option_settings:
  aws:elasticbeanstalk:environment:process:default:
    Port: '5000'
    Protocol: HTTP
    HealthCheckPath: /health
    MatcherHTTPCode: 200
    HealthCheckInterval: 15
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5

  aws:elasticbeanstalk:container:nodejs:
    NodeCommand: 'npm start'
