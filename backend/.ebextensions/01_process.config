# Elastic Beanstalk / Vessel health-check configuration.
#
# The app has no "/" route (only "/health" and "/api/*"), so the load
# balancer's default health check ("/") gets a 404 and marks the
# environment Degraded/Severe, which can trigger instance recycling.
# HealthCheckPath below fixes this.
#
# Deliberately NOT overriding Port here: the app already listens on
# process.env.PORT (see backend/server.js), so it follows whatever port
# the platform injects (Vessel's own convention — defaults to 8080).
# A previous version of this file pinned Port to '5000', which risked a
# mismatch between the platform-injected PORT env var and the ALB/
# target-group port if they ever disagreed — that would 502 every
# request. Let the platform own the port entirely.
option_settings:
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    MatcherHTTPCode: 200
    HealthCheckInterval: 15
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5

  aws:elasticbeanstalk:container:nodejs:
    NodeCommand: 'npm start'
